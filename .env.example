# Copy this file to .env and adjust. Local development defaults only.

# Container settings (read by compose.yaml)
TASKLINE_VALKEY_PORT=6380
# Standalone Postgres, started only with the "standalone" compose profile
TASKLINE_POSTGRES_PORT=5435
TASKLINE_POSTGRES_USER=taskline
TASKLINE_POSTGRES_PASSWORD=taskline
TASKLINE_POSTGRES_DB=taskline

# Connection settings (read by taskline)
TASKLINE_DATABASE_URL=postgresql+psycopg://taskline:taskline@127.0.0.1:5435/taskline
TASKLINE_VALKEY_URL=redis://127.0.0.1:6380/0

# The name of this Taskline instance, recorded in the database by `taskline migrate`.
# Default: the namespace.
# TASKLINE_INSTANCE_NAME=

# A database role that may read the taskline_api views and nothing else. `taskline migrate`
# grants it; the role must already exist.
# TASKLINE_API_READER_ROLE=

# Valkey: every stream and consumer group name starts with the namespace, so several
# applications can share one Valkey. Results are kept for a day. A message a worker has not
# acknowledged within the redelivery time is given to another worker.
TASKLINE_NAMESPACE=taskline
TASKLINE_RESULT_TTL_SECONDS=86400
TASKLINE_REDELIVERY_SECONDS=600

# The reaper wakes every interval and takes at most batch-size rows per check. A planned
# step the previous step never sent fails after the hand-off wait. A worker silent for
# the dead-worker time is marked dead.
TASKLINE_REAPER_INTERVAL_SECONDS=30
TASKLINE_REAPER_BATCH_SIZE=100
TASKLINE_HANDOFF_GRACE_SECONDS=120
TASKLINE_DEAD_WORKER_SECONDS=60

# The most the values passed between a job's steps may hold, as JSON, in bytes.
TASKLINE_MAX_VALUES_BYTES=262144

# Heartbeat: a running task renews its lease every interval; the lease lasts this many intervals.
TASKLINE_HEARTBEAT_INTERVAL_SECONDS=15
TASKLINE_LEASE_INTERVALS=4

# The queue a worker process reads.
TASKLINE_CONSUME_QUEUE=default

# Comma-separated modules that define task specs and jobs and nothing else. A program that
# submits or lists jobs, such as a web app, loads them with `taskline.api.load_catalogue()`.
TASKLINE_CATALOGUE_MODULES=

# Comma-separated Python modules. Workers load the task modules and the hook modules; the
# reaper loads only the hook modules. A stopping worker waits this long for running tasks.
TASKLINE_JOB_MODULES=
TASKLINE_HOOK_MODULES=
TASKLINE_SHUTDOWN_WAIT_SECONDS=30
